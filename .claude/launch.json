{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "dist-static",
        "-l",
        "8090",
        "-s"
      ],
      "port": 8090,
      "autoPort": false
    }
  ]
}
